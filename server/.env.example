# Copia este archivo a .env (en la carpeta server/) y ajusta los valores.
# El script de dev lo carga automáticamente (--env-file-if-exists=.env).

# Puerto de la API de Node/Express.
PORT=3001

# Motor de base de datos (aplica a usuarios, catálogo, ventas y oportunidades):
#   mssql  -> Microsoft SQL Server   [LOCAL / desarrollo]
#   mysql  -> MySQL / MariaDB        [PRODUCCIÓN / Plesk]
#   sqlite -> archivo server/auth.db (solo usuarios; sin instalar nada)
#   json   -> archivo server/data/db.json (solo usuarios)
DB_DRIVER=mssql

# --- LOCAL: SQL Server (DB_DRIVER=mssql) ---
DB_USER=sa
DB_PASSWORD=tu-contraseña-de-sql-server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Base_ventas

# --- PRODUCCIÓN: MySQL / MariaDB en Plesk (DB_DRIVER=mysql) ---
# Sustituye los DB_* de arriba por estos valores (mismas variables):
#   DB_DRIVER=mysql
#   DB_USER=sa
#   DB_PASSWORD=Nevoli123
#   DB_SERVER=localhost
#   DB_PORT=3306
#   DB_NAME=Ventas_Base

# Secreto para firmar los JWT. CÁMBIALO por algo largo y aleatorio en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Duración del token de sesión (ej. 15m, 1h, 7d).
JWT_EXPIRES=1h

# URL del frontend, usada para construir el enlace de recuperación.
CLIENT_URL=http://localhost:5173

# Entorno. En "production" no se devuelve devResetUrl en la respuesta.
# NODE_ENV=development
