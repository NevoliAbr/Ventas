# Copia este archivo a .env (en la carpeta server/) y ajusta los valores.
# El script de dev lo carga automáticamente (--env-file-if-exists=.env).

# Puerto de la API de Node/Express.
PORT=3001

# Motor de base de datos para los usuarios:
#   mssql  -> Microsoft SQL Server (requiere servidor corriendo)
#   sqlite -> archivo server/auth.db (sin instalar nada)
#   json   -> archivo server/data/db.json
DB_DRIVER=mssql

# Conexión a SQL Server (usada solo si DB_DRIVER=mssql).
DB_USER=sa
DB_PASSWORD=tu-contraseña-de-sql-server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Base_ventas

# Secreto para firmar los JWT. CÁMBIALO por algo largo y aleatorio en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Duración del token de sesión (ej. 15m, 1h, 7d).
JWT_EXPIRES=1h

# URL del frontend, usada para construir el enlace de recuperación.
CLIENT_URL=http://localhost:5173

# Entorno. En "production" no se devuelve devResetUrl en la respuesta.
# NODE_ENV=development
